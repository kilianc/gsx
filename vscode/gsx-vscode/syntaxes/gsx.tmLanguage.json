{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "gsx",
  "scopeName": "source.gsx",
  "patterns": [
    {
      "include": "#tag"
    },
    {
      "include": "source.go"
    }
  ],
  "repository": {
    "tag": {
      "patterns": [
        {
          "include": "#fragment"
        },
        {
          "include": "#component"
        },
        {
          "include": "#element"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "include": "#comment-splice"
        },
        {
          "include": "#spread"
        },
        {
          "include": "#splice"
        },
        {
          "comment": "name = value",
          "match": "([A-Za-z_:][A-Za-z0-9_.:-]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.gsx"
            },
            "2": {
              "name": "punctuation.separator.key-value.gsx"
            }
          }
        },
        {
          "comment": "valueless boolean attribute",
          "match": "([A-Za-z_:][A-Za-z0-9_.:-]*)(?=[\\s/>])",
          "name": "entity.other.attribute-name.gsx"
        },
        {
          "include": "#attribute-string"
        }
      ]
    },
    "attribute-string": {
      "name": "string.quoted.double.gsx",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.gsx"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.gsx"
        }
      },
      "patterns": [
        {
          "include": "#entity"
        },
        {
          "match": "\\\\.",
          "name": "constant.character.escape.gsx"
        }
      ]
    },
    "comment-splice": {
      "comment": "{/* ... */} is a JSX comment, dropped by the compiler",
      "name": "comment.block.gsx",
      "begin": "(\\{)\\s*(?=/\\*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.gsx"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.gsx"
        }
      }
    },
    "spread": {
      "name": "meta.embedded.block.go.gsx",
      "begin": "(\\{)(\\.\\.\\.)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.gsx"
        },
        "2": {
          "name": "keyword.operator.spread.gsx"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.gsx"
        }
      },
      "patterns": [
        {
          "include": "#splice-body"
        }
      ]
    },
    "splice": {
      "name": "meta.embedded.block.go.gsx",
      "begin": "(\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.gsx"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.gsx"
        }
      },
      "patterns": [
        {
          "include": "#splice-body"
        }
      ]
    },
    "splice-body": {
      "comment": "Inside a splice the language is Go again, and a tag may be nested in it.",
      "patterns": [
        {
          "include": "#nested-braces"
        },
        {
          "include": "#tag"
        },
        {
          "include": "source.go"
        }
      ]
    },
    "nested-braces": {
      "comment": "Composite literals and blocks inside a splice must not end it early.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#splice-body"
        }
      ]
    },
    "entity": {
      "name": "constant.character.entity.gsx",
      "match": "&(?:[a-zA-Z][a-zA-Z0-9]*|#[0-9]+|#[xX][0-9a-fA-F]+);"
    },
    "element": {
      "name": "meta.element.html.gsx",
      "begin": "(<)([a-z][a-zA-Z0-9-]*)(?=[\\s/>{])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.gsx"
        },
        "2": {
          "name": "entity.name.tag.gsx"
        }
      },
      "end": "(</)(\\2)\\s*(>)|(/>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.gsx"
        },
        "2": {
          "name": "entity.name.tag.gsx"
        },
        "3": {
          "name": "punctuation.definition.tag.end.gsx"
        },
        "4": {
          "name": "punctuation.definition.tag.end.gsx"
        }
      },
      "patterns": [
        {
          "include": "#tag-header"
        },
        {
          "include": "#children"
        }
      ]
    },
    "component": {
      "name": "meta.element.component.gsx",
      "begin": "(<)([A-Z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*|[a-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)+)(?=[\\s/>{])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.gsx"
        },
        "2": {
          "name": "support.class.component.gsx"
        }
      },
      "end": "(</)(\\2)\\s*(>)|(/>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.gsx"
        },
        "2": {
          "name": "support.class.component.gsx"
        },
        "3": {
          "name": "punctuation.definition.tag.end.gsx"
        },
        "4": {
          "name": "punctuation.definition.tag.end.gsx"
        }
      },
      "patterns": [
        {
          "include": "#tag-header"
        },
        {
          "include": "#children"
        }
      ]
    },
    "fragment": {
      "name": "meta.element.fragment.gsx",
      "begin": "(<>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.gsx"
        }
      },
      "end": "(</>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.gsx"
        }
      },
      "patterns": [
        {
          "include": "#children"
        }
      ]
    },
    "tag-header": {
      "comment": "Attributes only: \\G anchors this to the position right after the tag name, and it stops at the closing bracket without consuming a self-closing slash.",
      "begin": "\\G",
      "end": "(?=/>)|(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.gsx"
        }
      },
      "patterns": [
        {
          "include": "#attributes"
        }
      ]
    },
    "children": {
      "comment": "Content between tags. Deliberately does NOT include source.go: prose is text, and Go keywords in it must not be coloured as keywords.",
      "patterns": [
        {
          "include": "#comment-splice"
        },
        {
          "include": "#splice"
        },
        {
          "include": "#tag"
        },
        {
          "include": "#entity"
        }
      ]
    }
  }
}
